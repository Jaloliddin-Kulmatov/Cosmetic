# Vercel > Project > Settings > Environment Variables ga qo'shing.
# Bu qiymatlar maxfiy. Ularni git'ga yuklamang va hech kimga yubormang.

# MAJBURIY: Supabase > Connect > "Transaction pooler" qatori (port 6543).
# To'g'ridan-to'g'ri ulanish (db.xxx.supabase.co) Vercel'da ishlamaydi.
# Paroldagi maxsus belgilarni URL ko'rinishida yozing (masalan @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.xxxxxxxx:PAROL@aws-0-xxxx.pooler.supabase.com:6543/postgres

# Ixtiyoriy: shu email bilan ro'yxatdan o'tgan BIRINCHI hisob admin bo'ladi (faqat admin hali yo'q bo'lsa).
ADMIN_EMAIL=

# Ixtiyoriy do'kon ma'lumotlari
TELEGRAM_USERNAME=
SHOP_PHONE=
INSTAGRAM_USERNAME=LiberCosmetic
SHOP_ADDRESS=
MAP_URL=
